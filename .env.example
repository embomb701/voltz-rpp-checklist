# GitHub Personal Access Token (PAT)
# 1. Go to https://github.com/settings/tokens
# 2. Generate new token (classic) with at least "repo" scope
# 3. Copy the token and put it below
# 4. Save this file as .env (never commit .env)

GITHUB_TOKEN=ghp_replace_with_your_token

# Repository in format owner/repo
# Example: yourusername/voltz-rpp-checklist
GITHUB_REPO=yourusername/voltz-rpp-checklist
